---
---

<div class="preset-parser">
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <div class="max-w-7xl mx-auto bg-white shadow-xl rounded-lg overflow-hidden">
    <header class="bg-gray-800 text-white p-6">
      <h1 class="text-2xl md:text-3xl font-bold">Preset Application Log Parser</h1>
      <p class="mt-1 text-gray-300">
        This tool can be used to scan a green hippo engine file and find when a preset fired. Upload your console log file (.txt, .log) to filter and analyze 'PresetManager' events.
      </p>
    </header>

    <main class="p-6 md:p-8 space-y-6">
      <!-- Input Section -->
      <div>
        <label for="logFile" class="block text-sm font-medium text-gray-700 mb-2">Log File Input</label>
        <input type="file" id="logFile" class="block w-full text-sm text-gray-500 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 focus:outline-none" accept=".log,.txt,text/plain" />
      </div>

      <button id="parseButton" class="w-full md:w-auto px-6 py-3 bg-indigo-600 text-white font-semibold rounded-md shadow-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
        Parse Log File
      </button>
      <p id="statusMessage" class="text-sm text-gray-600 font-medium"></p>

      <!-- Results Section -->
      <div id="resultsContainer" class="hidden space-y-4">
        <div class="flex flex-col md:flex-row justify-between md:items-center gap-4">
          <div>
            <h2 class="text-xl md:text-2xl font-semibold">Parsed Events</h2>
            <p class="text-gray-600">Found <span id="eventCount" class="font-bold">0</span> 'PresetManager' application events.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-2">
            <button id="downloadButton" class="w-full md:w-auto px-6 py-2 bg-green-600 text-white font-semibold rounded-md shadow-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition duration-200">
              Download Report (.txt)
            </button>
            <button id="printButton" class="w-full md:w-auto px-6 py-2 bg-blue-600 text-white font-semibold rounded-md shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition duration-200">
              Save as PDF / Print
            </button>
          </div>
        </div>

        <!-- Legend -->
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 rounded bg-blue-100 border border-blue-400"></span>
            <span class="font-semibold text-blue-700">'On-Clock' Trigger</span>
            <span class="text-gray-600">(00, 15, 30, 45 mins)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 rounded bg-gray-50 border border-gray-300"></span>
            <span class="font-semibold text-gray-700">'Off-Clock' Trigger</span>
            <span class="text-gray-600">(Manual / Other)</span>
          </div>
        </div>

        <!-- Output Table -->
        <div class="overflow-x-auto shadow-md rounded-lg border border-gray-200">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Day of Week</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Time</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Preset Name</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Target</th>
              </tr>
            </thead>
            <tbody id="resultsTableBody" class="bg-white divide-y divide-gray-200">
              <!-- Rows will be injected here by JS -->
            </tbody>
          </table>
        </div>
        <div id="noResults" class="text-center py-12 text-gray-500 hidden">
          <p>No 'PresetManager' application events found in the log.</p>
        </div>
      </div>
    </main>
  </div>
</div>

<style>
  .preset-parser {
    font-family: 'Inter', sans-serif;
  }
  
  .preset-parser tbody tr {
    transition: background-color 0.2s ease-in-out;
  }
  
  .preset-parser input[type="file"]::file-selector-button {
    font-weight: 600;
    color: white;
    background-color: #4f46e5;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    margin-right: 1rem;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  
  .preset-parser input[type="file"]::file-selector-button:hover {
    background-color: #4338ca;
  }
  
  @media print {
    .preset-parser body {
      padding: 0;
      margin: 0;
      font-family: sans-serif;
    }
    
    .preset-parser header,
    .preset-parser main > div:first-child,
    .preset-parser #parseButton,
    .preset-parser #statusMessage,
    .preset-parser #downloadButton,
    .preset-parser #printButton,
    .preset-parser #resultsContainer > div:first-child,
    .preset-parser #resultsContainer > div:nth-child(2),
    .preset-parser #noResults {
      display: none;
    }

    .preset-parser #resultsContainer,
    .preset-parser main {
      display: block;
      padding: 0;
      margin: 0;
    }
    
    .preset-parser .overflow-x-auto,
    .preset-parser .max-w-7xl {
      box-shadow: none;
      border: none;
      overflow: visible;
    }
    
    .preset-parser #resultsContainer::before {
      content: 'Preset Application Log Report';
      display: block;
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 1rem;
      text-align: center;
    }
    
    .preset-parser tbody tr {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .preset-parser table {
      width: 100%;
    }
  }
</style>

<script is:inline>
  (function () {
    // --- DOM Elements ---
    const parseButton = document.getElementById('parseButton');
    const logFile = document.getElementById('logFile');
    const resultsContainer = document.getElementById('resultsContainer');
    const resultsTableBody = document.getElementById('resultsTableBody');
    const noResults = document.getElementById('noResults');
    const eventCount = document.getElementById('eventCount');
    const downloadButton = document.getElementById('downloadButton');
    const statusMessage = document.getElementById('statusMessage');
    const printButton = document.getElementById('printButton');

    // --- Global State ---
    let parsedData = [];
    const daysOfWeek = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    
    // Regex to capture the required log lines
    const logRegex = /(\d{2}\/\d{2}\/\d{4})\s(\d{2}:\d{2}:\d{2})\sDebug\sHostLocal: Component 'PresetManager': Applying '(.+?)' at '(.+?)'/;

    /**
     * A custom TransformStream to split the incoming text stream into lines.
     */
    class LineBreakTransformer {
      constructor() {
        this.container = '';
      }

      transform(chunk, controller) {
        this.container += chunk;
        const lines = this.container.split('\n');
        this.container = lines.pop();
        for (const line of lines) {
          controller.enqueue(line);
        }
      }

      flush(controller) {
        if (this.container) {
          controller.enqueue(this.container);
        }
      }
    }

    /**
     * Processes the log file stream line by line.
     */
    async function parseLogStream(file) {
      const results = [];
      const stream = file.stream();
      const decoder = new TextDecoderStream();
      
      const lineStream = stream
        .pipeThrough(decoder)
        .pipeThrough(new TransformStream(new LineBreakTransformer()));
      
      const reader = lineStream.getReader();

      let lineCount = 0;
      let matchCount = 0;

      try {
        while (true) {
          const { value, done } = await reader.read();
          if (done) break;

          const line = value;
          lineCount++;
          
          if(lineCount % 10000 === 0) {
            statusMessage.textContent = `Processing... Scanned ${lineCount.toLocaleString()} lines...`;
          }

          const match = line.match(logRegex);

          if (match) {
            matchCount++;
            const [fullMatch, dateStr, timeStr, presetName, target] = match;
            
            const [day, month, year] = dateStr.split('/');
            const [hours, minutes, seconds] = timeStr.split(':');
            
            const dateObj = new Date(year, month - 1, day, hours, minutes, seconds);
            const dayOfWeek = daysOfWeek[dateObj.getDay()];
            
            const mins = parseInt(minutes, 10);
            const isOnClock = (mins === 0 || mins === 15 || mins === 30 || mins === 45) && seconds === '00';

            results.push({
              dayOfWeek,
              dateStr,
              timeStr,
              isOnClock,
              presetName,
              target,
              timestamp: dateObj.getTime()
            });
          }
        }
      } catch (err) {
        console.error("Error reading stream:", err);
        statusMessage.textContent = `Error: ${err.message}`;
      }
      
      statusMessage.textContent = `Processing complete. Scanned ${lineCount.toLocaleString()} lines and found ${matchCount} events.`;
      return results;
    }

    /**
     * Populates the HTML table with the parsed data.
     */
    function populateTable() {
      parsedData.sort((a, b) => a.timestamp - b.timestamp);

      if (parsedData.length > 0) {
        parsedData.forEach(data => {
          const row = document.createElement('tr');
          
          const type = data.isOnClock ? 'On-Clock' : 'Off-Clock';
          
          if (data.isOnClock) {
            row.className = 'font-semibold text-blue-800 bg-blue-50 hover:bg-blue-100';
          } else {
            row.className = 'text-gray-700 opacity-80 hover:bg-gray-50';
          }

          row.innerHTML = `
            <td class="px-6 py-4 whitespace-nowrap text-sm">${data.dayOfWeek}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">${data.dateStr}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">${data.timeStr}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm ${data.isOnClock ? 'font-bold' : ''}">${type}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">${data.presetName}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">${data.target}</td>
          `;
          resultsTableBody.appendChild(row);
        });
        
        noResults.classList.add('hidden');
        resultsContainer.classList.remove('hidden');
      } else {
        noResults.classList.remove('hidden');
        resultsContainer.classList.add('hidden');
      }

      eventCount.textContent = parsedData.length;
    }

    // --- Event Listeners ---

    parseButton.addEventListener('click', async () => {
      const file = logFile.files[0];
      
      if (!file) {
        statusMessage.textContent = 'Please select a log file first.';
        return;
      }

      resultsTableBody.innerHTML = '';
      parsedData = [];
      parseButton.disabled = true;
      statusMessage.textContent = 'Starting processing...';
      resultsContainer.classList.add('hidden');
      noResults.classList.add('hidden');

      try {
        parsedData = await parseLogStream(file);
        populateTable();
      } catch (error) {
        console.error('Failed to parse log file:', error);
        statusMessage.textContent = 'An error occurred while parsing the file.';
      }

      parseButton.disabled = false;
    });

    downloadButton.addEventListener('click', () => {
      if (parsedData.length === 0) return;

      let fileContent = "Preset Application Log Report\n";
      fileContent += "===================================\n\n";

      fileContent += "--- On-Clock Triggers (Scheduled) ---\n";
      parsedData
        .filter(d => d.isOnClock)
        .forEach(d => {
          fileContent += `${d.dayOfWeek}, ${d.dateStr} @ ${d.timeStr} | Preset: '${d.presetName}' | Target: '${d.target}'\n`;
        });

      fileContent += "\n--- Off-Clock Triggers (Manual) ---\n";
      parsedData
        .filter(d => !d.isOnClock)
        .forEach(d => {
          fileContent += `${d.dayOfWeek}, ${d.dateStr} @ ${d.timeStr} | Preset: '${d.presetName}' | Target: '${d.target}'\n`;
        });

      const blob = new Blob([fileContent], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      
      a.href = url;
      a.download = 'preset_log_report.txt';
      document.body.appendChild(a);
      a.click();
      
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
    
    printButton.addEventListener('click', () => {
      window.print();
    });
  })();
</script>


