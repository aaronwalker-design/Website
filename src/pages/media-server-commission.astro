---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MainCard from "@/components/MainCard.astro";
---

<BaseLayout title="Media Server Commission" isIndexed={false}>
  <MainCard
    title="Media Server Commission Script Generator"
    description="Generate PowerShell scripts for configuring multiple servers with VLANs and network adapters"
    textOverlay="POWERSHELL"
    infoIcon="lucide:server"
  >
    <div class="powershell-generator text-sm">
      <!-- Configuration Section -->
      <div class="space-y-3 mb-4">
        <h2 class="text-lg font-bold">Configuration</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <!-- PC Name -->
          <div class="form-control">
            <label class="label py-1">
              <span class="label-text text-xs font-semibold">PC Name Prefix</span>
            </label>
            <select id="pc-name-prefix" class="select select-bordered select-sm mb-2">
              <option value="SRV">SRV (SRV101, SRV102, etc.)</option>
              <option value="SERVER">SERVER (SERVER101, SERVER102, etc.)</option>
              <option value="__CUSTOM__">Custom...</option>
            </select>
            <input
              type="text"
              id="pc-name"
              class="input input-bordered input-sm hidden"
              placeholder="Enter custom prefix"
            />
          </div>

          <!-- Number of Machines -->
          <div class="form-control">
            <label class="label py-1">
              <span class="label-text text-xs font-semibold">Number of Machines</span>
            </label>
            <input type="number" id="num-machines" class="input input-bordered input-sm" min="1" value="1" />
          </div>

          <!-- Network Technology -->
          <div class="form-control">
            <label class="label py-1">
              <span class="label-text text-xs font-semibold">Network Technology</span>
            </label>
            <div class="flex gap-3">
              <label class="label cursor-pointer py-1">
                <span class="label-text text-xs mr-1">Hyper-V</span>
                <input
                  type="radio"
                  name="network-tech"
                  id="hyperv"
                  class="radio radio-primary radio-sm"
                  value="hyperv"
                  checked
                />
              </label>
              <label class="label cursor-pointer py-1">
                <span class="label-text text-xs mr-1">Intel NetTeaming</span>
                <input type="radio" name="network-tech" id="intel" class="radio radio-primary radio-sm" value="intel" />
              </label>
            </div>
          </div>
        </div>

        <!-- VLANs Table Section -->
        <div class="form-control mt-4">
          <div class="flex justify-between items-center mb-2">
            <label class="label py-1">
              <span class="label-text text-xs font-semibold">VLANs Configuration</span>
            </label>
            <button type="button" id="add-vlan-btn" class="btn btn-sm btn-primary">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-3 w-3 mr-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Add VLAN
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="table table-compact table-bordered w-full text-xs">
              <thead>
                <tr>
                  <th class="p-1">VLAN Name</th>
                  <th class="p-1">Base IP Address / DHCP</th>
                  <th class="p-1">Subnet Mask</th>
                  <th class="p-1">NIC Selection</th>
                  <th class="p-1 w-12">Action</th>
                </tr>
              </thead>
              <tbody id="vlans-tbody">
                <!-- VLAN rows will be added here -->
              </tbody>
            </table>
          </div>
        </div>

        <div class="flex gap-2 mt-3">
          <button type="button" id="generate-btn" class="btn btn-primary btn-sm flex-1">
            #1 Generate PowerShell Scripts
          </button>
          <button type="button" id="download-current-btn" class="btn btn-sm btn-outline" disabled>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3 w-3 mr-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            #2 Download Current
          </button>
          <button type="button" id="download-all-btn" class="btn btn-sm btn-outline" disabled>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3 w-3 mr-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            #2 Download All
          </button>
        </div>
      </div>

      <!-- Output Section -->
      <div class="space-y-2 mt-6">
        <div class="flex justify-between items-center">
          <h2 class="text-base font-bold">Generated Script Preview</h2>
          <div class="flex gap-2">
            <select id="preview-machine" class="select select-bordered select-sm text-xs">
              <option value="1">Machine 1</option>
            </select>
            <button type="button" id="copy-btn" class="btn btn-sm btn-outline">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-3 w-3 mr-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                ></path>
              </svg>
              Copy
            </button>
          </div>
        </div>

        <div class="relative">
          <pre
            id="output"
            class="bg-base-200 p-2 rounded text-xs font-mono overflow-x-auto max-h-[500px] overflow-y-auto"><code class="language-powershell"># Generated PowerShell script will appear here</code></pre>
        </div>

        <div id="copy-success" class="alert alert-success alert-sm hidden py-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="stroke-current shrink-0 h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-xs">Script copied to clipboard!</span>
        </div>

        <div id="generate-success" class="alert alert-info alert-sm hidden py-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="stroke-current shrink-0 h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span id="generate-message" class="text-xs"></span>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        let vlanCounter = 0;
        let generatedScripts = {};

        function addVlanRow() {
          vlanCounter++;
          const tbody = document.getElementById("vlans-tbody");
          const row = document.createElement("tr");
          row.className = "vlan-row";
          row.dataset.vlanId = vlanCounter;

          row.innerHTML = `
            <td class="p-1">
              <select class="select select-xs select-bordered w-full vlan-name">
                <option value="">-- Select Network Type --</option>
                <option value="Automation Net (PSN)">Automation Net (PSN)</option>
                <option value="d3Net">d3Net</option>
                <option value="Data 1">Data 1</option>
                <option value="Data 2">Data 2</option>
                <option value="Data 3">Data 3</option>
                <option value="Data 4">Data 4</option>
                <option value="HippoNet">HippoNet</option>
                <option value="Internet">Internet</option>
                <option value="KVM Net">KVM Net</option>
                <option value="MGMT (Management)">MGMT (Management)</option>
                <option value="Media Net">Media Net</option>
                <option value="NDI">NDI</option>
                <option value="OmniCal">OmniCal</option>
                <option value="OSC/Control">OSC/Control</option>
                <option value="PTZ Camera Control">PTZ Camera Control</option>
                <option value="RenderStream">RenderStream</option>
                <option value="sACN/Artnet">sACN/Artnet</option>
                <option value="__CUSTOM__">Custom...</option>
              </select>
              <input type="text" class="input input-xs input-bordered w-full vlan-name-custom hidden mt-1" placeholder="Enter custom VLAN name" />
            </td>
            <td class="p-1">
              <div class="relative">
                <input type="text" list="ip-options-${vlanCounter}" class="input input-xs input-bordered w-full vlan-ip" placeholder="192.168.0.1" />
                <datalist id="ip-options-${vlanCounter}">
                  <option value="DHCP">DHCP</option>
                  <option value="192.168.0.1">192.168.0.1</option>
                  <option value="192.168.0.10">192.168.0.10</option>
                  <option value="172.50.10.10">172.50.10.10</option>
                  <option value="2.0.0.1">2.0.0.1</option>
                  <option value="10.0.0.1">10.0.0.1</option>
                </datalist>
              </div>
            </td>
            <td class="p-1">
              <input type="text" class="input input-xs input-bordered w-full vlan-subnet" placeholder="255.255.255.0" value="255.255.255.0" />
            </td>
            <td class="p-1">
              <div class="relative">
                <input type="text" list="nic-options-${vlanCounter}" class="input input-xs input-bordered w-full vlan-nic" placeholder="Ethernet, Ethernet 2, etc." />
                <datalist id="nic-options-${vlanCounter}">
                  <option value="Ethernet">Ethernet</option>
                  <option value="Ethernet 1">Ethernet 1</option>
                  <option value="Ethernet 2">Ethernet 2</option>
                  <option value="Ethernet 3">Ethernet 3</option>
                  <option value="Ethernet 4">Ethernet 4</option>
                </datalist>
              </div>
            </td>
            <td class="p-1 text-center">
              <button type="button" class="btn btn-xs btn-ghost delete-vlan" data-vlan-id="${vlanCounter}">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </td>
          `;

          tbody.appendChild(row);

          // Add delete handler
          const deleteBtn = row.querySelector(".delete-vlan");
          deleteBtn.addEventListener("click", function () {
            row.remove();
            if (Object.keys(generatedScripts).length > 0) {
              updatePreview();
            }
          });

          // Handle VLAN name dropdown change
          const vlanNameSelect = row.querySelector(".vlan-name");
          const vlanNameCustom = row.querySelector(".vlan-name-custom");
          vlanNameSelect.addEventListener("change", function () {
            if (this.value === "__CUSTOM__") {
              vlanNameCustom.classList.remove("hidden");
              vlanNameCustom.focus();
            } else {
              vlanNameCustom.classList.add("hidden");
              vlanNameCustom.value = "";
            }
          });

          // Handle IP input change (for DHCP detection)
          const ipInput = row.querySelector(".vlan-ip");
          const subnetInput = row.querySelector(".vlan-subnet");
          ipInput.addEventListener("input", function () {
            if (this.value.toUpperCase() === "DHCP") {
              subnetInput.disabled = true;
              subnetInput.value = "";
              subnetInput.classList.add("opacity-50");
            } else {
              subnetInput.disabled = false;
              if (!subnetInput.value) {
                subnetInput.value = "255.255.255.0";
              }
              subnetInput.classList.remove("opacity-50");
            }
          });
        }

        function getVlanData() {
          const rows = document.querySelectorAll(".vlan-row");
          const vlans = [];
          rows.forEach((row) => {
            const nameSelect = row.querySelector(".vlan-name");
            const nameCustom = row.querySelector(".vlan-name-custom");
            let name = "";

            // Get VLAN name from dropdown or custom input
            if (nameSelect.value === "__CUSTOM__") {
              name = nameCustom.value.trim();
            } else {
              name = nameSelect.value.trim();
            }

            const ip = row.querySelector(".vlan-ip").value.trim();
            const subnet = row.querySelector(".vlan-subnet").value.trim();
            const nic = row.querySelector(".vlan-nic").value.trim();
            const dhcp = ip.toUpperCase() === "DHCP";

            if (name && (dhcp || ip)) {
              vlans.push({ name, ip: dhcp ? null : ip, subnet: dhcp ? null : subnet || "255.255.255.0", nic, dhcp });
            }
          });
          return vlans;
        }

        function incrementIP(ip, increment) {
          const parts = ip.split(".").map(Number);
          parts[3] += increment;

          while (parts[3] > 255) {
            parts[3] -= 256;
            parts[2]++;
          }
          while (parts[2] > 255) {
            parts[2] -= 256;
            parts[1]++;
          }
          while (parts[1] > 255) {
            parts[1] -= 256;
            parts[0]++;
          }

          return parts.join(".");
        }

        function getPcNamePrefix() {
          const prefixSelect = document.getElementById("pc-name-prefix");
          const customInput = document.getElementById("pc-name");

          if (prefixSelect.value === "__CUSTOM__") {
            return customInput.value.trim() || "SERVER";
          }
          return prefixSelect.value || "SRV";
        }

        function getFullPcName(machineNumber) {
          const prefix = getPcNamePrefix();
          const startNumber = 101;
          const machineNum = startNumber + (machineNumber - 1);
          return `${prefix}${machineNum}`;
        }

        function generatePowerShell(machineNumber) {
          const fullPcName = getFullPcName(machineNumber);
          const networkTech = document.querySelector('input[name="network-tech"]:checked').value;
          const vlans = getVlanData();

          let script = "";

          script += `# PowerShell Script for ${fullPcName}\n`;
          script += `# Generated: ${new Date().toLocaleString()}\n`;
          script += `# Network Technology: ${networkTech === "hyperv" ? "Hyper-V" : "Intel NetTeaming"}\n\n`;

          script += `# Check if running as administrator\n`;
          script += `$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)\n`;
          script += `if (-not $isAdmin) {\n`;
          script += `    Write-Host "This script requires administrator privileges. Please run as administrator." -ForegroundColor Red\n`;
          script += `    exit 1\n`;
          script += `}\n\n`;

          script += `# Get installed network adapters (including those without connection)\n`;
          script += `# This is important for dry-run scenarios where adapters may not be connected\n`;
          script += `$adapters = Get-NetAdapter | Where-Object { $_.InterfaceDescription -notlike '*Hyper-V*' -and $_.InterfaceDescription -notlike '*Virtual*' -and $_.InterfaceDescription -notlike '*TAP*' -and $_.InterfaceDescription -notlike '*Loopback*' }\n`;
          script += `if ($null -eq $adapters -or $adapters.Count -eq 0) {\n`;
          script += `    Write-Host "No physical network adapters found!" -ForegroundColor Red\n`;
          script += `    exit 1\n`;
          script += `}\n\n`;

          script += `Write-Host "Found $($adapters.Count) network adapter(s):" -ForegroundColor Green\n`;
          script += `$adapters | ForEach-Object { \n`;
          script += `    $statusColor = if ($_.Status -eq 'Up') { 'Green' } else { 'Yellow' }\n`;
          script += `    $statusText = if ($_.Status -eq 'Up') { 'Connected' } else { 'Disconnected' }\n`;
          script += `    Write-Host "  - $($_.Name) ($($_.InterfaceDescription)) - Status: $statusText" -ForegroundColor $statusColor\n`;
          script += `}\n\n`;

          script += `# Function to show adapter selection GUI\n`;
          script += `function Show-AdapterSelection {\n`;
          script += `    param([array]$Adapters, [string]$VlanName)\n`;
          script += `    Add-Type -AssemblyName System.Windows.Forms\n`;
          script += `    Add-Type -AssemblyName System.Drawing\n`;
          script += `    $form = New-Object System.Windows.Forms.Form\n`;
          script += `    $form.Text = "Select Network Adapter for $VlanName"\n`;
          script += `    $form.Size = New-Object System.Drawing.Size(400, 300)\n`;
          script += `    $form.StartPosition = "CenterScreen"\n`;
          script += `    $label = New-Object System.Windows.Forms.Label\n`;
          script += `    $label.Location = New-Object System.Drawing.Point(10, 10)\n`;
          script += `    $label.Size = New-Object System.Drawing.Size(360, 20)\n`;
          script += `    $label.Text = "Select network adapter for $VlanName :"\n`;
          script += `    $form.Controls.Add($label)\n`;
          script += `    $listBox = New-Object System.Windows.Forms.ListBox\n`;
          script += `    $listBox.Location = New-Object System.Drawing.Point(10, 40)\n`;
          script += `    $listBox.Size = New-Object System.Drawing.Size(360, 180)\n`;
          script += `    $adapters | ForEach-Object { [void]$listBox.Items.Add($_.Name) }\n`;
          script += `    $form.Controls.Add($listBox)\n`;
          script += `    $okButton = New-Object System.Windows.Forms.Button\n`;
          script += `    $okButton.Location = New-Object System.Drawing.Point(200, 230)\n`;
          script += `    $okButton.Size = New-Object System.Drawing.Size(75, 23)\n`;
          script += `    $okButton.Text = "OK"\n`;
          script += `    $okButton.DialogResult = [System.Windows.Forms.DialogResult]::OK\n`;
          script += `    $form.Controls.Add($okButton)\n`;
          script += `    $cancelButton = New-Object System.Windows.Forms.Button\n`;
          script += `    $cancelButton.Location = New-Object System.Drawing.Point(295, 230)\n`;
          script += `    $cancelButton.Size = New-Object System.Drawing.Size(75, 23)\n`;
          script += `    $cancelButton.Text = "Cancel"\n`;
          script += `    $cancelButton.DialogResult = [System.Windows.Forms.DialogResult]::Cancel\n`;
          script += `    $form.Controls.Add($cancelButton)\n`;
          script += `    $form.AcceptButton = $okButton\n`;
          script += `    $form.CancelButton = $cancelButton\n`;
          script += `    if ($form.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {\n`;
          script += `        return $listBox.SelectedItem\n`;
          script += `    }\n`;
          script += `    return $null\n`;
          script += `}\n\n`;

          vlans.forEach((vlan, index) => {
            const machineIP = vlan.dhcp ? null : incrementIP(vlan.ip, machineNumber - 1);

            script += `# Configure ${vlan.name}\n`;
            script += `Write-Host "\nConfiguring ${vlan.name}..." -ForegroundColor Cyan\n`;

            if (vlan.nic) {
              script += `$adapterName = "${vlan.nic}"\n`;
              script += `$adapter = Get-NetAdapter -Name $adapterName -ErrorAction SilentlyContinue\n`;
              script += `if ($null -eq $adapter) {\n`;
              script += `    Write-Host "Adapter '$adapterName' not found. Showing selection dialog..." -ForegroundColor Yellow\n`;
              script += `    $selectedAdapter = Show-AdapterSelection -Adapters $adapters -VlanName "${vlan.name}"\n`;
              script += `    if ($null -eq $selectedAdapter) {\n`;
              script += `        Write-Host "No adapter selected for ${vlan.name}. Skipping..." -ForegroundColor Red\n`;
              script += `        continue\n`;
              script += `    }\n`;
              script += `    $adapter = Get-NetAdapter -Name $selectedAdapter\n`;
              script += `}\n`;
            } else {
              script += `$selectedAdapter = Show-AdapterSelection -Adapters $adapters -VlanName "${vlan.name}"\n`;
              script += `if ($null -eq $selectedAdapter) {\n`;
              script += `    Write-Host "No adapter selected for ${vlan.name}. Skipping..." -ForegroundColor Red\n`;
              script += `    continue\n`;
              script += `}\n`;
              script += `$adapter = Get-NetAdapter -Name $selectedAdapter\n`;
            }

            script += `$adapterName = $adapter.Name\n`;
            script += `Write-Host "Using adapter: $adapterName" -ForegroundColor Green\n\n`;

            if (networkTech === "hyperv") {
              script += `# Create Hyper-V Virtual Switch (per Disguise methodology)\n`;
              script += `# Reference: https://help.disguise.one/designer/networking/create-a-vlan-hyperv\n`;
              script += `$switchName = "$adapterName-Switch"\n`;
              script += `$existingSwitch = Get-VMSwitch -Name $switchName -ErrorAction SilentlyContinue\n`;
              script += `if ($null -eq $existingSwitch) {\n`;
              script += `    Write-Host "Creating Hyper-V Virtual Switch: $switchName" -ForegroundColor Yellow\n`;
              script += `    Write-Host "Using adapter: $adapterName" -ForegroundColor Cyan\n`;
              script += `    New-VMSwitch -Name $switchName -NetAdapterName $adapterName -AllowManagementOS $true\n`;
              script += `    Write-Host "Switch created successfully" -ForegroundColor Green\n`;
              script += `} else {\n`;
              script += `    Write-Host "Switch '$switchName' already exists" -ForegroundColor Yellow\n`;
              script += `}\n`;
              script += `# Note: Do not assign multiple adapters to the same switch - this can cause setup to fail after reboot\n\n`;

              script += `# Add VLAN Network Adapter to the switch (per Disguise methodology)\n`;
              script += `$vlanAdapterName = "${vlan.name}"\n`;
              script += `$vlanId = ${index + 1}\n`;
              script += `$existingVlanAdapter = Get-VMNetworkAdapter -ManagementOS -Name $vlanAdapterName -ErrorAction SilentlyContinue\n`;
              script += `if ($null -eq $existingVlanAdapter) {\n`;
              script += `    Write-Host "Adding VLAN adapter '$vlanAdapterName' to switch '$switchName'..." -ForegroundColor Yellow\n`;
              script += `    Add-VMNetworkAdapter -ManagementOS -Name $vlanAdapterName -SwitchName $switchName\n`;
              script += `    Write-Host "VLAN adapter created successfully" -ForegroundColor Green\n`;
              script += `} else {\n`;
              script += `    Write-Host "VLAN adapter '$vlanAdapterName' already exists" -ForegroundColor Yellow\n`;
              script += `}\n\n`;

              script += `# Configure VLAN ID on the adapter\n`;
              script += `Write-Host "Configuring VLAN ID $vlanId on adapter '$vlanAdapterName'..." -ForegroundColor Yellow\n`;
              script += `Set-VMNetworkAdapterVlan -ManagementOS -VMNetworkAdapterName $vlanAdapterName -Access -VlanId $vlanId\n\n`;

              if (vlan.dhcp) {
                script += `# Configure DHCP on the VLAN adapter\n`;
                script += `Write-Host "Configuring DHCP for ${vlan.name}..." -ForegroundColor Yellow\n`;
                script += `\n`;
                script += `# Remove existing static IP configuration\n`;
                script += `Remove-NetIPAddress -InterfaceAlias $vlanAdapterName -Confirm:$false -ErrorAction SilentlyContinue\n`;
                script += `Remove-NetRoute -InterfaceAlias $vlanAdapterName -Confirm:$false -ErrorAction SilentlyContinue\n`;
                script += `\n`;
                script += `# Enable DHCP\n`;
                script += `Set-NetIPInterface -InterfaceAlias $vlanAdapterName -Dhcp Enabled\n`;
                script += `Write-Host "${vlan.name} configured for DHCP successfully" -ForegroundColor Green\n\n`;
              } else {
                script += `# Configure IP Address on the VLAN adapter\n`;
                script += `$ipAddress = "${machineIP}"\n`;
                script += `$subnetMask = "${vlan.subnet}"\n`;
                script += `# Calculate prefix length from subnet mask\n`;
                script += `$maskParts = $subnetMask -split '\\\\.'\n`;
                script += `$prefixLength = 0\n`;
                script += `foreach ($octet in $maskParts) {\n`;
                script += `    $binary = [Convert]::ToString([int]$octet, 2)\n`;
                script += `    $prefixLength += ($binary -replace '0', '').Length\n`;
                script += `}\n`;
                script += `Write-Host "Configuring IP Address: $ipAddress / $subnetMask (Prefix: $prefixLength)" -ForegroundColor Yellow\n`;
                script += `\n`;
                script += `# Remove existing IP configuration on the VLAN adapter\n`;
                script += `Remove-NetIPAddress -InterfaceAlias $vlanAdapterName -Confirm:$false -ErrorAction SilentlyContinue\n`;
                script += `Remove-NetRoute -InterfaceAlias $vlanAdapterName -Confirm:$false -ErrorAction SilentlyContinue\n`;
                script += `\n`;
                script += `# Configure new IP address\n`;
                script += `New-NetIPAddress -InterfaceAlias $vlanAdapterName -IPAddress $ipAddress -PrefixLength $prefixLength\n`;
                script += `Write-Host "${vlan.name} configured successfully" -ForegroundColor Green\n\n`;
              }
            } else {
              script += `# Create Intel NetTeaming using PROSet Cmdlets\n`;
              script += `# Reference: https://help.disguise.one/designer/networking/create-a-proset-team-cmdlets\n`;
              script += `\n`;
              script += `# Import Intel PROSet module\n`;
              script += `$intelModulePath = "C:\\Program Files\\Intel\\Wired Networking\\IntelNetCmdlets"\n`;
              script += `if (Test-Path $intelModulePath) {\n`;
              script += `    Import-Module $intelModulePath -ErrorAction Stop\n`;
              script += `    Write-Host "Intel PROSet module loaded successfully" -ForegroundColor Green\n`;
              script += `} else {\n`;
              script += `    Write-Host "Intel PROSet module not found at $intelModulePath" -ForegroundColor Red\n`;
              script += `    Write-Host "Please install Intel Network Adapter Drivers with PROSet." -ForegroundColor Yellow\n`;
              script += `    exit 1\n`;
              script += `}\n\n`;

              script += `# Create Intel NetTeam\n`;
              script += `$teamName = "$adapterName-Team"\n`;
              script += `$existingTeam = Get-IntelNetTeam -TeamName $teamName -ErrorAction SilentlyContinue\n`;
              script += `if ($null -eq $existingTeam) {\n`;
              script += `    Write-Host "Creating Intel NetTeam: $teamName" -ForegroundColor Yellow\n`;
              script += `    Write-Host "Using adapter: $adapterName" -ForegroundColor Cyan\n`;
              script += `    # Note: For X722 adapters, you may need an additional 1GB adapter (sacrificial NIC) in the team\n`;
              script += `    New-IntelNetTeam -TeamMemberNames $adapterName -TeamMode AdaptiveLoadBalancing -TeamName $teamName\n`;
              script += `    Write-Host "Team created successfully" -ForegroundColor Green\n`;
              script += `} else {\n`;
              script += `    Write-Host "Team '$teamName' already exists" -ForegroundColor Yellow\n`;
              script += `}\n\n`;

              script += `# Add VLAN to the team\n`;
              script += `$vlanId = ${index + 1}\n`;
              script += `Write-Host "Adding VLAN ID $vlanId to team '$teamName'..." -ForegroundColor Yellow\n`;
              script += `$existingVlan = Get-IntelNetVLAN -ParentName $teamName -VLANID $vlanId -ErrorAction SilentlyContinue\n`;
              script += `if ($null -eq $existingVlan) {\n`;
              script += `    Add-IntelNetVLAN -ParentName $teamName -VLANID $vlanId\n`;
              script += `    Write-Host "VLAN ID $vlanId added successfully" -ForegroundColor Green\n`;
              script += `} else {\n`;
              script += `    Write-Host "VLAN ID $vlanId already exists on team '$teamName'" -ForegroundColor Yellow\n`;
              script += `}\n\n`;

              script += `# Get the VLAN interface name (Intel PROSet creates interfaces with specific naming)\n`;
              script += `# The interface name is typically the team name with VLAN ID\n`;
              script += `$vlanInterfaceName = "$teamName-VLAN$vlanId"\n`;
              script += `# Wait a moment for the interface to be created\n`;
              script += `Start-Sleep -Seconds 2\n`;
              script += `\n`;
              script += `# Verify the VLAN interface exists\n`;
              script += `$vlanInterface = Get-NetAdapter -Name "*$vlanInterfaceName*" -ErrorAction SilentlyContinue\n`;
              script += `if ($null -eq $vlanInterface) {\n`;
              script += `    # Try alternative naming convention\n`;
              script += `    $vlanInterface = Get-NetAdapter | Where-Object { $_.InterfaceDescription -like "*$teamName*" -and $_.Name -like "*VLAN*" }\n`;
              script += `    if ($null -ne $vlanInterface) {\n`;
              script += `        $vlanInterfaceName = $vlanInterface.Name\n`;
              script += `        Write-Host "Found VLAN interface: $vlanInterfaceName" -ForegroundColor Green\n`;
              script += `    } else {\n`;
              script += `        Write-Host "Warning: Could not find VLAN interface. Attempting to configure anyway..." -ForegroundColor Yellow\n`;
              script += `    }\n`;
              script += `}\n\n`;

              if (vlan.dhcp) {
                script += `# Configure DHCP on the VLAN interface\n`;
                script += `Write-Host "Configuring DHCP for ${vlan.name}..." -ForegroundColor Yellow\n`;
                script += `\n`;
                script += `# Remove existing static IP configuration\n`;
                script += `Remove-NetIPAddress -InterfaceAlias $vlanInterfaceName -Confirm:$false -ErrorAction SilentlyContinue\n`;
                script += `Remove-NetRoute -InterfaceAlias $vlanInterfaceName -Confirm:$false -ErrorAction SilentlyContinue\n`;
                script += `\n`;
                script += `# Enable DHCP\n`;
                script += `Set-NetIPInterface -InterfaceAlias $vlanInterfaceName -Dhcp Enabled\n`;
                script += `Write-Host "${vlan.name} configured for DHCP successfully" -ForegroundColor Green\n\n`;
              } else {
                script += `# Configure IP Address on the VLAN interface\n`;
                script += `$ipAddress = "${machineIP}"\n`;
                script += `$subnetMask = "${vlan.subnet}"\n`;
                script += `# Calculate prefix length from subnet mask\n`;
                script += `$maskParts = $subnetMask -split '\\\\.'\n`;
                script += `$prefixLength = 0\n`;
                script += `foreach ($octet in $maskParts) {\n`;
                script += `    $binary = [Convert]::ToString([int]$octet, 2)\n`;
                script += `    $prefixLength += ($binary -replace '0', '').Length\n`;
                script += `}\n`;
                script += `Write-Host "Configuring IP Address: $ipAddress / $subnetMask (Prefix: $prefixLength)" -ForegroundColor Yellow\n`;
                script += `\n`;
                script += `# Remove existing IP configuration\n`;
                script += `Remove-NetIPAddress -InterfaceAlias $vlanInterfaceName -Confirm:$false -ErrorAction SilentlyContinue\n`;
                script += `Remove-NetRoute -InterfaceAlias $vlanInterfaceName -Confirm:$false -ErrorAction SilentlyContinue\n`;
                script += `\n`;
                script += `# Configure new IP address\n`;
                script += `New-NetIPAddress -InterfaceAlias $vlanInterfaceName -IPAddress $ipAddress -PrefixLength $prefixLength\n`;
                script += `Write-Host "${vlan.name} configured successfully" -ForegroundColor Green\n\n`;
              }
            }
          });

          script += `Write-Host "\nConfiguration completed for ${fullPcName}!" -ForegroundColor Green\n`;
          script += `Write-Host "Please verify network connectivity." -ForegroundColor Yellow\n`;

          return script;
        }

        function generateAllScripts() {
          const numMachines = parseInt(document.getElementById("num-machines").value) || 1;
          const vlans = getVlanData();

          if (vlans.length === 0) {
            alert("Please add at least one VLAN configuration.");
            return;
          }

          generatedScripts = {};

          for (let i = 1; i <= numMachines; i++) {
            generatedScripts[i] = generatePowerShell(i);
          }

          const previewSelect = document.getElementById("preview-machine");
          previewSelect.innerHTML = "";
          for (let i = 1; i <= numMachines; i++) {
            const option = document.createElement("option");
            option.value = i;
            const fullName = getFullPcName(i);
            option.textContent = `Machine ${i} (${fullName})`;
            previewSelect.appendChild(option);
          }

          // Enable download buttons
          document.getElementById("download-current-btn").disabled = false;
          document.getElementById("download-all-btn").disabled = false;

          updatePreview();

          const successDiv = document.getElementById("generate-success");
          const message = document.getElementById("generate-message");
          const firstMachine = getFullPcName(1);
          const lastMachine = getFullPcName(numMachines);
          message.textContent = `Generated ${numMachines} PowerShell script(s). Use the preview dropdown to view each script, or click "Download All" to download all scripts to your Downloads folder.`;
          successDiv.classList.remove("hidden");

          setTimeout(() => {
            successDiv.classList.add("hidden");
          }, 10000);
        }

        function updatePreview() {
          const machineNum = parseInt(document.getElementById("preview-machine").value) || 1;
          const script = generatedScripts[machineNum] || "";
          const output = document.getElementById("output");
          const div = document.createElement("div");
          div.textContent = script || "# No script generated yet. Fill in the table and click Generate.";
          output.innerHTML = `<code class="language-powershell">${div.innerHTML}</code>`;
        }

        function copyToClipboard() {
          const machineNum = parseInt(document.getElementById("preview-machine").value) || 1;
          const script = generatedScripts[machineNum];
          if (!script) {
            alert("No script generated yet. Please generate scripts first.");
            return;
          }
          navigator.clipboard
            .writeText(script)
            .then(() => {
              const successMsg = document.getElementById("copy-success");
              successMsg.classList.remove("hidden");
              setTimeout(() => {
                successMsg.classList.add("hidden");
              }, 2000);
            })
            .catch((err) => {
              console.error("Failed to copy:", err);
              alert("Failed to copy to clipboard. Please select and copy manually.");
            });
        }

        function downloadCurrentScript() {
          const machineNum = parseInt(document.getElementById("preview-machine").value) || 1;
          const script = generatedScripts[machineNum];

          if (!script) {
            alert("No script generated yet. Please generate scripts first.");
            return;
          }

          const fullPcName = getFullPcName(machineNum);
          const blob = new Blob([script], { type: "application/x-powershell" });
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = `${fullPcName}.ps1`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);

          // Show success message
          const successMsg = document.getElementById("copy-success");
          successMsg.querySelector("span").textContent = `Downloaded ${fullPcName}.ps1!`;
          successMsg.classList.remove("hidden");
          setTimeout(() => {
            successMsg.classList.add("hidden");
          }, 2000);
        }

        function downloadAllScripts() {
          if (Object.keys(generatedScripts).length === 0) {
            alert("No scripts generated yet. Please generate scripts first.");
            return;
          }

          const numMachines = Object.keys(generatedScripts).length;

          // Download each script with a small delay to avoid browser blocking
          let delay = 0;
          Object.keys(generatedScripts).forEach((machineNum) => {
            setTimeout(() => {
              const script = generatedScripts[machineNum];
              const fullPcName = getFullPcName(parseInt(machineNum));
              const blob = new Blob([script], { type: "application/x-powershell" });
              const url = URL.createObjectURL(blob);
              const a = document.createElement("a");
              a.href = url;
              a.download = `${fullPcName}.ps1`;
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
              URL.revokeObjectURL(url);
            }, delay);
            delay += 200; // 200ms delay between each download
          });

          // Show success message
          const successMsg = document.getElementById("copy-success");
          successMsg.querySelector("span").textContent =
            `Downloaded ${numMachines} PowerShell script(s) to your Downloads folder!`;
          successMsg.classList.remove("hidden");
          setTimeout(() => {
            successMsg.classList.add("hidden");
          }, 3000);
        }

        // Initialize on page load
        document.addEventListener("DOMContentLoaded", function () {
          const generateBtn = document.getElementById("generate-btn");
          const copyBtn = document.getElementById("copy-btn");
          const addVlanBtn = document.getElementById("add-vlan-btn");
          const downloadCurrentBtn = document.getElementById("download-current-btn");
          const downloadAllBtn = document.getElementById("download-all-btn");
          const previewSelect = document.getElementById("preview-machine");
          const pcNamePrefix = document.getElementById("pc-name-prefix");
          const pcNameCustom = document.getElementById("pc-name");

          if (generateBtn) generateBtn.addEventListener("click", generateAllScripts);
          if (copyBtn) copyBtn.addEventListener("click", copyToClipboard);
          if (addVlanBtn) addVlanBtn.addEventListener("click", addVlanRow);
          if (downloadCurrentBtn) downloadCurrentBtn.addEventListener("click", downloadCurrentScript);
          if (downloadAllBtn) downloadAllBtn.addEventListener("click", downloadAllScripts);
          if (previewSelect) previewSelect.addEventListener("change", updatePreview);

          // Handle PC name prefix dropdown
          if (pcNamePrefix && pcNameCustom) {
            pcNamePrefix.addEventListener("change", function () {
              if (this.value === "__CUSTOM__") {
                pcNameCustom.classList.remove("hidden");
                pcNameCustom.focus();
              } else {
                pcNameCustom.classList.add("hidden");
                pcNameCustom.value = "";
              }
            });
          }

          // Add initial VLAN row
          addVlanRow();
        });
      })();
    </script>

    <style>
      .powershell-generator {
        font-size: 0.875rem;
      }

      .powershell-generator .label {
        padding-top: 0.25rem;
        padding-bottom: 0.25rem;
      }

      #output {
        font-size: 0.75rem;
        line-height: 1.4;
      }

      #output code {
        color: #d4d4d4;
        background: transparent;
        display: block;
        white-space: pre;
      }

      .table th,
      .table td {
        padding: 0.25rem;
      }

      @media (prefers-color-scheme: light) {
        #output {
          background-color: #1e1e1e;
          color: #d4d4d4;
        }
      }
    </style>
  </MainCard>
</BaseLayout>
